# ==========================================
# DEPO DESTEK ASİSTANI YAPILANDIRMASI
# ==========================================

# Google Gemini API Anahtarı (İsteğe bağlı: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Model
GEMINI_MODEL=gemini-2.5-flash

# Asistan ve Kurum Tanımları
BOT_NAME=Depo Destek Asistanı
COMPANY_NAME=Depo & Lojistik Yönetimi

# Web Kontrol Paneli Portu
PORT=3000

# Otomatik Cevaplama Aktif mi? (true / false)
AUTO_REPLY=true

# Grup Mesajlarını Yoksay (true = Sadece bireysel özel mesajlara cevap verir)
IGNORE_GROUPS=true

# Cevap vermeden önceki yazıyor gecikmesi (milisaniye cinsinden)
REPLY_DELAY_MS=1000

# Excel Stok & Raf Dosyası Konumu (Boş bırakılırsa proje klasöründeki Raf Yerleri.xlsx kullanılır)
# Örn: EXCEL_PATH=C:\Depo\Guncel_Raf_Yerleri.xlsx veya D:\Ortak\Raf_Yerleri.xlsx
EXCEL_PATH=
